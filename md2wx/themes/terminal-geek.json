    "code_bg": "#020617",
    "code_text": "#34d399",
    "quote_bg": "#0f172a",
    "page_bg": "#0b0f19"
  },
  "typography": {
    "font_family": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace",

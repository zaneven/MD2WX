# 微信公众平台开发者凭据 (可选，仅在需要使用 --publish 直接推送到草稿箱时配置)
WECHAT_APP_ID=your_wechat_app_id_here
WECHAT_APP_SECRET=your_wechat_app_secret_here

# 在线图床配置 (可选，配置后 CLI --upload-image 与 Web Studio 上传图片可用；未配置则提示不支持上传)
# 参考 WePost 图床：向一个自定义上传接口 POST multipart/form-data，返回 JSON 含图片地址。
# IMAGE_HOST_UPLOAD_URL    必填，上传接口完整地址 (如 https://your-image-host/api/uploads)
# IMAGE_HOST_TOKEN         可选，鉴权令牌 (作为请求头 Authorization 发送，除非设置 IMAGE_HOST_TOKEN_FIELD)
# IMAGE_HOST_TOKEN_FIELD   可选，令牌作为表单字段发送 (如对接 imgbb 的 key 字段)
# IMAGE_HOST_AUTH_HEADER   可选，令牌请求头名，默认 Authorization
# IMAGE_HOST_AUTH_PREFIX   可选，令牌前缀，默认空 (如需 "Bearer " 显式设置)
# IMAGE_HOST_FILE_FIELD    可选，文件表单字段名，默认 file
# IMAGE_HOST_RESPONSE_PATH 可选，响应中图片 URL 的路径，支持点号嵌套，默认 url
# IMAGE_HOST_TIMEOUT       可选，请求超时秒数，默认 30
IMAGE_HOST_UPLOAD_URL=your_image_host_upload_url_here
# IMAGE_HOST_TOKEN=
# IMAGE_HOST_TOKEN_FIELD=
# IMAGE_HOST_AUTH_HEADER=Authorization
# IMAGE_HOST_AUTH_PREFIX=
# IMAGE_HOST_FILE_FIELD=file
# IMAGE_HOST_RESPONSE_PATH=url
# IMAGE_HOST_TIMEOUT=30

# Web Studio 构建期图床配置 (Vite 仅注入 VITE_ 前缀变量)
# 注意：VITE_ 变量会被打包进公开静态产物，请勿填入敏感令牌；仅用于无鉴权的公开上传端点。
# VITE_IMAGE_HOST_UPLOAD_URL=
# VITE_IMAGE_HOST_TOKEN=
# VITE_IMAGE_HOST_FILE_FIELD=file
# VITE_IMAGE_HOST_RESPONSE_PATH=url
